NODE_ENV=development
PORT=3000
# api = HTTP + WebSocket ; worker = files BullMQ ; all = les deux (dev)
PROCESS_ROLE=all
DATABASE_URL=postgres://vtc:vtc@localhost:5433/vtc
REDIS_URL=redis://localhost:6380
CORS_ORIGINS=http://localhost:3001

# Secrets : générer avec `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
OTP_SECRET=change-me-change-me-change-me-change-me
DATA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

SMS_PROVIDER=console
# Dev uniquement (refusé si NODE_ENV=production) : code OTP fixe pour les tests
OTP_DEV_FIXED_CODE=123456

# Premier admin (utilisé par db:seed)
ADMIN_PHONE=+21620000000

# Documents chauffeur : stockage privé local (dev). Pièces exigées avant approbation (vide = aucune, pour tester à la main)
STORAGE_DIR=./storage
# DRIVER_REQUIRED_DOCUMENTS=cin,driving_license,vehicle_registration,insurance

# Portefeuille chauffeur : au-delà de cette dette de commissions cash (millimes, 50000 = 50 DT), le chauffeur ne peut plus
# passer en ligne tant qu'il n'a pas réglé. Valeur de travail à caler sur le marché.
# DRIVER_DEBT_CEILING=50000

# Trace GPS des courses : durée de conservation en jours (purge automatique)
# LOCATION_RETENTION_DAYS=90

# Cartographie. static = jeu d'adresses intégré (dev uniquement, refusé en production) ; nominatim = OpenStreetMap
# (instance publique limitée : auto-héberger ou changer de fournisseur avant la production)
# GEOCODING_PROVIDER=static
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# straight = distance à vol d'oiseau ; osrm = distance/durée réelles (extrait OSM Tunisie, repli automatique si indisponible)
# ROUTING_PROVIDER=straight
# OSRM_URL=http://localhost:5000
